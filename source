local ROLES = {
    ["Member"] = 1, ["Player"] = 1, ["Advisor"] = 4, ["Kage"] = 5,
    ["Lore Team"] = 249, ["Administration"] = 250, ["Management"] = 252,
    ["Engineer"] = 254, ["Owner"] = 255
}
local modAction = "Notify"
SecMod:Dropdown({
    Name = "action", Flag = "mod_action",
    List = { "Notify", "Leave", "Webhook", "Leave + Webhook" },
    Default = "Notify",
    Callback = function(v) modAction = v end
})
SecMod:Toggle({
    Name = "enabled", Flag = "mod_on", Default = false,
    Callback = function(v)
        if not v then return end
        RT:go(function()
            while RT.alive and v do
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr == LP then continue end
                    local rank = plr:GetRankInGroup(0) or 0
                    local role = plr:GetRoleInGroup(0) or ""
                    for name, minRank in pairs(ROLES) do
                        if rank >= minRank and rank >= 240 then
                            if modAction == "Notify" or modAction == "Leave + Webhook" then
                                Window:Notify("Mod", plr.Name .. " (" .. role .. ")", "shield", 5)
                            end
                            if modAction == "Webhook" or modAction == "Leave + Webhook" then
                                sendWebhook("mod detected: " .. plr.Name .. " (" .. role .. ")")
                            end
                            if modAction == "Leave" or modAction == "Leave + Webhook" then
                                LP:Kick("mod detected")
                            end
                            break
                        end
                    end
                end
                task.wait(2)
            end
        end)
    end
})

