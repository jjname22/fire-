-- ─────────────────────────────────────────────────────────────
-- Runtime guard  (clean restart on re-exec)
-- ─────────────────────────────────────────────────────────────
if _G.FVRuntime then
    pcall(function() _G.FVRuntime:Stop() end)
end

local RT = { alive = true, conns = {}, threads = {} }
_G.FVRuntime = RT

function RT:on(sig, fn)
    local c = sig:Connect(function(...) if self.alive then fn(...) end end)
    self.conns[#self.conns+1] = c
end

function RT:go(fn)
    local th
    th = task.spawn(function()
        local ok, err = pcall(fn)
        self.threads[th] = nil
        if not ok then warn("[Fire]", err) end
    end)
    self.threads[th] = true
    return th
end

function RT:Stop()
    self.alive = false
    for _, c in ipairs(self.conns) do pcall(function() c:Disconnect() end) end
    for th in pairs(self.threads) do pcall(task.cancel, th) end
    table.clear(self.conns)
    table.clear(self.threads)
    if _G.FVRuntime == self then _G.FVRuntime = nil end
end

