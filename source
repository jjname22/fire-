-- ── Quick-fire buttons (one-shot, farm doesn't need to be on) ─
SecQuick:Button({
    Name = "fire delivery once",
    Callback = function()
        RT:go(function()
            local m = getMission()
            if not m then Window:Notify("Delivery","no mission","x",2); return end
            for _, name in ipairs({"Letter","DeliverPart"}) do
                local p = m:FindFirstChild(name)
                if p then
                    local pos = partPos(p)
                    if pos then moveTo(pos) end
                    task.wait(0.15); fireAll(p); task.wait(S.FireDelay)
                end
            end
            if S.SafeSpot then goSafe() end
            Window:Notify("Delivery","done","check",2)
        end)
    end
})

SecQuick:Button({
    Name = "fire trash once",
    Callback = function()
        RT:go(function()
            local m = getMission()
            if not m then Window:Notify("Trash","no mission","x",2); return end
            local n = 0
            for _, child in ipairs(m:GetChildren()) do
                if child.Name:lower():find("trash") then
                    standOn(child); task.wait(0.2)
                    fireAll(child); waitGone(child, S.TrashWait+2); n+=1
                end
            end
            if n==0 then Window:Notify("Trash","nothing found","x",2); return end
            if S.SafeSpot then goSafe() end
            Window:Notify("Trash","done ("..n.."x)","check",2)
        end)
    end
})

SecQuick:Button({
    Name = "accept mission now",
    Callback = function()
        local boards = workspace:FindFirstChild("MissionBoards")
        if not boards then Window:Notify("Mission","no boards","x",2); return end
        for _, board in ipairs(boards:GetChildren()) do
            local cp = board:FindFirstChild("Clickpart") or board:FindFirstChild("ClickPart")
            if cp then
                local meh = cp:FindFirstChild("Meh") or cp
                if meh:IsA("BasePart") then fireTouch(meh) end
                for _, d in ipairs(cp:GetDescendants()) do fireClick(d) end
            end
        end
        Window:Notify("Mission","accepted","check",2)
    end
})

SecQuick:Button({
    Name = "fire rescue once",
    Callback = function()
        RT:go(function()
            local boxes  = workspace:FindFirstChild("MissionBoxes")
            local rescue = boxes and boxes:FindFirstChild("LeafRescue")
            if not rescue then Window:Notify("Rescue","not found","x",2); return end
            local door     = rescue:FindFirstChild("DoorSensorPart")
            local arena    = rescue:FindFirstChild("ArenaSensorPart")
            local prisoner = rescue:FindFirstChild("PrisonerSensorPart")
            task.wait(2)
            if door then standOn(door); task.wait(0.2); fireTouch(door); task.wait(S.FireDelay) end
            goSafe(); task.wait(0.35)
            if arena    then for _=1,S.RescueFires do fireTouch(arena);    task.wait(S.FireDelay) end end
            if prisoner then for _=1,S.RescueFires do fireTouch(prisoner); task.wait(S.FireDelay) end end
            Window:Notify("Rescue","done","check",2)
        end)
    end
})

