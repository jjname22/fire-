-- Player movement
-- ─────────────────────────────────────────────────────────────
RT:on(RunService.Heartbeat, function()
    if not S.NoFall then return end
    local _, hum, hrp = char(); if not hum then return end
    local st = hum:GetState()
    if st == Enum.HumanoidStateType.Freefall
    or st == Enum.HumanoidStateType.FallingDown
    or st == Enum.HumanoidStateType.Ragdoll then
        pcall(function()
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end)
        if hrp then
            local v = hrp.AssemblyLinearVelocity
            if v.Y < -50 then hrp.AssemblyLinearVelocity = Vector3.new(v.X, -50, v.Z) end
        end
    end
end)

RT:on(RunService.Heartbeat, function()
    local _, hum, c2 = char(); if not hum then return end
    if S.SpeedOn  then hum.WalkSpeed = S.SpeedVal end
    if S.Noclip and c2 then
        for _, p in ipairs(c2:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
end)

-- fly
local flyBV, flyBG
local lastRebuild = 0

local function stopFly()
    if flyBV then pcall(function() flyBV:Destroy() end); flyBV = nil end
    if flyBG then pcall(function() flyBG:Destroy() end); flyBG = nil end
end

local function ensureFly()
    local _, _, hrp = char(); if not hrp then stopFly(); return end
    if flyBV and flyBV.Parent == hrp then return hrp end
    stopFly()
    flyBV = Instance.new("BodyVelocity")
    flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    flyBV.Velocity = Vector3.zero
    flyBV.Parent   = hrp
    flyBG = Instance.new("BodyGyro")
    flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyBG.P         = 9e4
    flyBG.Parent    = hrp
    lastRebuild = os.clock()
    return hrp
end

RT:on(RunService.RenderStepped, function()
    if not S.FlyOn then if flyBV then stopFly() end; return end
    if not flyBV or not flyBV.Parent or os.clock()-lastRebuild > 1 then ensureFly() end
    local hrp = ensureFly(); if not hrp or not flyBV then return end
    local cam = workspace.CurrentCamera; if not cam then return end
    local dir = Vector3.zero
    if UIS:IsKeyDown(Enum.KeyCode.W)           then dir += cam.CFrame.LookVector  end
    if UIS:IsKeyDown(Enum.KeyCode.S)           then dir -= cam.CFrame.LookVector  end
    if UIS:IsKeyDown(Enum.KeyCode.A)           then dir -= cam.CFrame.RightVector end
    if UIS:IsKeyDown(Enum.KeyCode.D)           then dir += cam.CFrame.RightVector end
    if UIS:IsKeyDown(Enum.KeyCode.Space)       then dir += Vector3.yAxis           end
    if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis           end
    flyBV.Velocity = dir.Magnitude > 0 and dir.Unit * S.FlySpeed or Vector3.zero
    if flyBG then flyBG.CFrame = cam.CFrame end
end)

local UIS = UserInputService
RT:on(UIS.JumpRequest, function()
    if S.InfJump and not UIS:GetFocusedTextBox() then
        local _, hum = char(); if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
