-- ─────────────────────────────────────────────────────────────
local function char()
    local c   = LP.Character
    local hum = c and c:FindFirstChildOfClass("Humanoid")
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    if hum and hrp and hum.Health > 0 then return c, hum, hrp end
end

-- ─────────────────────────────────────────────────────────────
-- Movement primitives
-- ─────────────────────────────────────────────────────────────
local function tpTo(pos)
    local _, _, hrp = char(); if not hrp then return end
    hrp.CFrame = CFrame.new(pos + Vector3.new(0, 4, 0))
end

local function tweenTo(pos, spd)
    local _, _, hrp = char(); if not hrp then return end
    spd = spd or S.TweenSpeed
    local goal = pos + Vector3.new(0, 3, 0)
    local t    = math.clamp((hrp.Position - goal).Magnitude / math.max(spd, 1), 0.05, 12)
    local tw   = TweenService:Create(hrp, TweenInfo.new(t, Enum.EasingStyle.Linear), { CFrame = CFrame.new(goal) })
    tw:Play(); tw.Completed:Wait()
end

local function moveTo(pos)
    if S.Method == "TP" then tpTo(pos) else tweenTo(pos) end
end

local function goSafe()
    tpTo(S.SafePos)
end

local function standOn(part)
    local _, _, hrp = char(); if not hrp or not part then return end
    local bp = part:IsA("BasePart") and part or part:FindFirstChildWhichIsA("BasePart")
    if not bp then return end
    hrp.CFrame                   = CFrame.new(bp.Position + Vector3.new(0, 4, 0))
    hrp.AssemblyLinearVelocity   = Vector3.zero
    hrp.AssemblyAngularVelocity  = Vector3.zero
end

local function partPos(part)
    if not part then return nil end
    if part:IsA("BasePart") then return part.Position end
    local bp = part:FindFirstChildWhichIsA("BasePart")
    return bp and bp.Position
end

-- ─────────────────────────────────────────────────────────────
-- Touch / click
-- ─────────────────────────────────────────────────────────────
local function fireTouch(part)
    if not part then return end
    local _, _, hrp = char(); if not hrp then return end
    local ti = part:FindFirstChildOfClass("TouchTransmitter") or part:FindFirstChild("TouchInterest")
    if ti and firetouchinterest then
        pcall(firetouchinterest, part, hrp, 0)
        task.wait(0.05)
        pcall(firetouchinterest, part, hrp, 1)
    else
        local old = hrp.CFrame
        hrp.CFrame = part.CFrame
        task.wait(0.05)
        hrp.CFrame = old
    end
end

local function fireClick(d)
    if d and d:IsA("ClickDetector") and fireclickdetector then
        pcall(fireclickdetector, d)
    end
end

-- fire touch + every click detector inside
local function fireAll(part)
    if not part then return end
    fireTouch(part)
    for _, d in ipairs(part:GetDescendants()) do fireClick(d) end
end

local function waitGone(part, limit)
    local t0 = os.clock()
    while part and part.Parent and os.clock() - t0 < (limit or 12) do
        if not RT.alive then return end
        task.wait(0.15)
    end
end

