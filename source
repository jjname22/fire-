local function getMoney()
    local ok, t = pcall(function() return LP.PlayerGui.HUD.Display.Ryo.Text end)
    if not ok or not t then return S.LastMoney end
    local n = tonumber((tostring(t):gsub("[^%d%.]", ""))) or 0
    S.LastMoney = n; return n
end

local function fmt(n)
    n = math.floor(n + 0.5)
    if n >= 1e6 then return ("%.2fM"):format(n/1e6) end
    if n >= 1e3 then return ("%.1fK"):format(n/1e3) end
    return tostring(n)
end

local function bar(current, goal, emoji)
    local pct = math.clamp(current / math.max(goal, 1), 0, 1)
    local filled = math.floor(pct * 10)
    return emoji:rep(filled) .. "░":rep(10 - filled) .. " " .. math.floor(pct * 100) .. "%"
end

local function sendWebhook(reason)
    if not S.WebhookOn or S.WebhookUrl == "" then return end
    local money   = getMoney()
    local elapsed = math.max(os.clock() - S.SessionStart, 1)
    local gained  = money - S.StartMoney
    local pMin    = gained / (elapsed / 60)
    local pHour   = pMin * 60
    local mins, secs = math.floor(elapsed/60), math.floor(elapsed%60)
    local desc = "**"..(reason or "update").."**\n\n"
    desc = desc .. "🟦 Money\n" .. bar(money, S.GoalMoney, "🟦") .. "\n\n"
    desc = desc .. "🟩 Delivery\n" .. bar(S.DeliveryDone, S.GoalDelivery, "🟩") .. "\n\n"
    desc = desc .. "🟥 Trash\n" .. bar(S.TrashDone, S.GoalTrash, "🟥") .. "\n\n"
    desc = desc .. "🟨 Rescue\n" .. bar(S.RescueDone, S.GoalRescue, "🟨")
    pcall(function()
        local HS   = game:GetService("HttpService")
        local body = HS:JSONEncode({ username = "Fire Village", embeds = {{ 
            title       = "🔥 Fire Village",
            description = desc,
            color       = S.Running and 5763719 or 15548997,
            fields      = {
                { name="Status",   value=S.Running and "🟢 Running" or "🔴 Stopped", inline=true },
                { name="Money",    value="`"..fmt(money).." / "..fmt(S.GoalMoney).."`", inline=true },
                { name="Gained",   value="`+"..fmt(gained).."`", inline=true },
                { name="Per Min",  value="`"..fmt(pMin).."`",    inline=true },
                { name="Per Hour", value="`"..fmt(pHour).."`",   inline=true },
                { name="Session",  value=string.format("`%dm %ds`",mins,secs), inline=true },
            },
            footer    = { text = "Fire Village · "..os.date("%Y-%m-%d %H:%M:%S") },
            timestamp = DateTime.now():ToIsoDate(),
        }}})
        local req = (syn and syn.request) or (http and http.request) or request or http_request
        if req then req({ Url=S.WebhookUrl, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body }) end
    end)
end

local function webhookLoop()
    while RT.alive and S.WebhookOn and S.Running do
        local w = math.max(S.WebhookMin*60 + S.WebhookSec, 15)
        sendWebhook("scheduled update")
        task.wait(w)
    end
end

