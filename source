-- ESP
-- ─────────────────────────────────────────────────────────────
local espGui = Instance.new("Folder"); espGui.Name = "FireESP"; espGui.Parent = CoreGui
local espObjs = {}

local function clearEsp()
    for _, v in pairs(espObjs) do
        pcall(function() v.bill:Destroy() end)
        pcall(function() v.hl:Destroy() end)
    end
    table.clear(espObjs)
end

local function addEsp(plr)
    if plr == LP or espObjs[plr] then return end
    local c = plr.Character; local hrp = c and c:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local bill  = Instance.new("BillboardGui")
    bill.Adornee = hrp; bill.Size = UDim2.fromOffset(120,40)
    bill.AlwaysOnTop = true; bill.Parent = espGui
    local lbl   = Instance.new("TextLabel", bill)
    lbl.Size = UDim2.fromScale(1,1); lbl.BackgroundTransparency = 1
    lbl.TextColor3 = S.EspColor; lbl.TextStrokeTransparency = 0.4
    lbl.Font = Enum.Font.GothamBold; lbl.TextSize = 13
    local hl    = Instance.new("Highlight")
    hl.Adornee = c; hl.FillColor = S.EspColor
    hl.OutlineColor = Color3.new(1,1,1); hl.FillTransparency = 0.7
    hl.OutlineTransparency = 0; hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = espGui
    espObjs[plr] = { bill=bill, lbl=lbl, hl=hl }
end

RT:on(RunService.RenderStepped, function()
    if not S.EspOn then if next(espObjs) then clearEsp() end; return end
    local cam = workspace.CurrentCamera; if not cam then return end
    local seen = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local c = plr.Character; local hrp = c and c:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        local dist = (hrp.Position - cam.CFrame.Position).Magnitude
        if dist > S.EspMaxDist then continue end
        seen[plr] = true
        if not espObjs[plr] then addEsp(plr) end
        local obj = espObjs[plr]
        if obj then
            local txt = S.EspName and plr.DisplayName or ""
            if S.EspDist then txt = txt..(txt~="" and "\n" or "")..("%.0fm"):format(dist) end
            obj.lbl.Text = txt; obj.lbl.TextColor3 = S.EspColor
            if obj.hl then obj.hl.FillColor = S.EspColor; obj.hl.Enabled = S.EspBox end
        end
    end
    for plr, obj in pairs(espObjs) do
        if not seen[plr] then
            pcall(function() obj.bill:Destroy() end)
            pcall(function() obj.hl:Destroy() end)
            espObjs[plr] = nil
        end
    end
end)

Players.PlayerRemoving:Connect(function(plr)
    if espObjs[plr] then
        pcall(function() espObjs[plr].bill:Destroy() end)
        pcall(function() espObjs[plr].hl:Destroy() end)
        espObjs[plr] = nil
    end
end)

