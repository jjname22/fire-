local function sendControl(action)
    if controlPending then return end
    if type(requestFn) ~= "function" or not data or not data.controls or not data.controls[action] then
        controlMessage, controlMessageUntil = "Control unavailable", os.clock() + 3; return
    end
    controlPending = true
    task.spawn(function()
        local success, response = pcall(requestFn, {Url="http://127.0.0.1:8787/control", Method="POST",
            Headers={["Content-Type"]="application/json"}, Body=HttpService:JSONEncode({action=action})})
        if not alive then return end
        local decoded, result = false, nil
        if success and type(response) == "table" then
            decoded, result = pcall(function() return HttpService:JSONDecode(response.Body or response.body) end)
        end
        controlMessage = decoded and result and (result.ok and "Command sent" or result.error) or "Control unavailable"
        controlMessageUntil, controlPending = os.clock() + 3, false
    end)
end
