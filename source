            tried, nextAttempt = path, os.clock() + 30
            local success, response = pcall(requestFn, {Url="http://127.0.0.1:8787" .. path, Method="GET"})
            if not alive then break end
            if success and type(response) == "table" and (response.StatusCode or response.status_code) == 200 then
                local bytes = response.Body or response.body
                local headers = response.Headers or response.headers or {}
                local mime = headers["Content-Type"] or headers["content-type"] or "image/jpeg"
                local name = "Vitality/Assets/gs-cover-" .. path:match("key=(%x+)") .. (mime:find("png", 1, true) and ".png" or ".jpg")
                local saved, asset = pcall(function()
                    assert(type(bytes) == "string" and #bytes <= 2000000)
                    writefile(name, bytes); return assetFn(name)
                end)
                if saved and data and data.album_art == path and alive then
                    artworkImage.Image, artworkImage.Visible, loaded = asset, true, path
                    table.insert(files, name)
                    if #files > 20 and type(delfile) == "function" then pcall(delfile, table.remove(files, 1)) end
                end
            end
        elseif path == "" then tried, loaded = "", "" end
        task.wait(1)
    end
