local function fixLibraryTitle(source)
    local broken = 'SettingsPage.Window.Items["ActualTitle"].Instance.Text = Value'
    local first, last = source:find(broken, 1, true)
    if first then
        local replacement = [[local container = SettingsPage.Window.Items["ActualTitle"].Instance
                        if container:IsA("TextLabel") then container.Text = Value else
                            local assigned = false
                            for _, child in ipairs(container:GetChildren()) do
                                if child:IsA("TextLabel") then
                                    child.Text = assigned and "" or Value
                                    assigned = true
                                end
                            end
                        end]]
        source = source:sub(1, first - 1) .. replacement .. source:sub(last + 1)
    end
    return source
end
