-- helper: get current village mission model
local function getMission()
    local bin = workspace:FindFirstChild("vmBin")
    return bin and bin:FindFirstChild("frikashi5's village mission")
end

-- ── Delivery: move to Letter / DeliverPart, fire, go safe ───
local function loopDelivery()
    while RT.alive and S.Running and S.DoDelivery do
        lock("delivery")
        local mission = getMission()
        if not mission then
            if S.SafeSpot then goSafe() end
            task.wait(1); continue
        end
        for _, name in ipairs({ "Letter", "DeliverPart" }) do
            if not (RT.alive and S.Running and S.DoDelivery) then break end
            local part = mission:FindFirstChild(name)
            if part then
                local pos = partPos(part)
                if pos then moveTo(pos) end
                task.wait(0.15)
                fireAll(part)
                task.wait(S.FireDelay)
                S.DeliveryDone += 1
            end
        end
        if S.SafeSpot then goSafe() end
        unlock("delivery")
        task.wait(0.3)
    end
    unlock("delivery")
end

-- ── Trash: stand on each TrashPart, fire, wait it despawns ──
local function loopTrash()
    while RT.alive and S.Running and S.DoTrash do
        lock("trash")
        local mission = getMission()
        if not mission then
            if S.SafeSpot then goSafe() end
            task.wait(1); continue
        end
        local found = false
        for _, child in ipairs(mission:GetChildren()) do
            if not (RT.alive and S.Running and S.DoTrash) then break end
            if child.Name:lower():find("trash") then
                found = true
                local pos = partPos(child)
                if pos then
                    if S.Method == "TP" then
                        standOn(child)
                    else
                        tweenTo(pos); task.wait(0.1); standOn(child)
                    end
                end
                task.wait(0.2)
                fireAll(child)
                waitGone(child, S.TrashWait + 2)
                S.TrashDone += 1
            end
        end
        if not found then unlock("trash"); task.wait(1); continue end
        if S.SafeSpot then goSafe() end
        unlock("trash")
        task.wait(0.3)
    end
    unlock("trash")
end

-- ── Mission accept: click boards in-place ───────────────────
local function loopMission()
    while RT.alive and S.Running and S.DoMission do
        local boards = workspace:FindFirstChild("MissionBoards")
        if boards then
            for _, board in ipairs(boards:GetChildren()) do
                local cp = board:FindFirstChild("Clickpart") or board:FindFirstChild("ClickPart")
                if cp then
                    local meh = cp:FindFirstChild("Meh") or cp
                    if meh:IsA("BasePart") then fireTouch(meh) end
                    for _, d in ipairs(cp:GetDescendants()) do fireClick(d) end
                end
            end
        end
        task.wait(S.MissionPause)
    end
end

-- ── Rescue: TP door → safe → fire arena + prisoner ──────────
local function loopRescue()
    while RT.alive and S.Running and S.DoRescue do
        lock("rescue")
        local boxes  = workspace:FindFirstChild("MissionBoxes")
        local rescue = boxes and boxes:FindFirstChild("LeafRescue")
        if not rescue then
            if S.SafeSpot then goSafe() end
            task.wait(1); continue
        end
        local door     = rescue:FindFirstChild("DoorSensorPart")
        local arena    = rescue:FindFirstChild("ArenaSensorPart")
        local prisoner = rescue:FindFirstChild("PrisonerSensorPart")
        task.wait(2)
        if door then
            standOn(door); task.wait(0.2)
            fireTouch(door); task.wait(S.FireDelay)
        end
        goSafe(); task.wait(0.35)
        if arena    then for _=1, S.RescueFires do fireTouch(arena);    task.wait(S.FireDelay) end end
        if prisoner then for _=1, S.RescueFires do fireTouch(prisoner); task.wait(S.FireDelay) end end
        S.RescueDone += 1
        unlock("rescue")
        task.wait(0.8)
    end
    unlock("rescue")
end

-- ─────────────────────────────────────────────────────────────
-- Master start / stop (called by the main toggle)
-- ─────────────────────────────────────────────────────────────
local function startFarm()
    S.Running      = true
    S.StartMoney   = getMoney()
    S.SessionStart = os.clock()
    S.DeliveryDone = 0
    S.TrashDone    = 0
    S.RescueDone   = 0
    if S.DoDelivery then RT:go(loopDelivery) end
    if S.DoTrash    then RT:go(loopTrash)    end
    if S.DoMission  then RT:go(loopMission)  end
    if S.DoRescue   then RT:go(loopRescue)   end
    if S.WebhookOn  then RT:go(webhookLoop)  end
    sendWebhook("session started")
    Window:Notify("Farm", "running", "play", 2)
end

local function stopFarm()
    S.Running = false
    sendWebhook("session stopped")
    Window:Notify("Farm", "stopped", "square", 2)
end

-- helper: restart a single job if farm is already running
local function kickJob(flag, loopFn)
    if S.Running and flag then RT:go(loopFn) end
end

