-- ══════════════════════════════════════════════════════════════
--  VILLAGE FARM
-- ══════════════════════════════════════════════════════════════
local function installVillage()
    local TweenService = game:GetService("TweenService")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local player = Players.LocalPlayer
    local villages = {
        Leaf = Vector3.new(-5012, 1024, 1336), Sand = Vector3.new(-3177, 1241, -5216),
        Stone = Vector3.new(3565, 1364, -1248), Mist = Vector3.new(-723, 481, 5429)
    }
    local state = {
        running = false, delivery = false, trash = false, mission = false,
        rescue = false, rescueM1 = false, m1Depth = 6, m1Interval = 0.2,
        village = "Leaf", method = "Tween", speed = 120, depth = 40, fireDelay = 0.15,
        trashWait = 3, trashDepth = 3, rescueFires = 3, boardPause = 1.5, safe = false,
        speedOn = false, walkSpeed = 32, fly = false, flySpeed = 60, noclip = false,
        -- ── jump limiter ──────────────────────────────────────
        jump = false,          -- infinite jump enabled
        jumpLimit = 0,         -- 0 = unlimited; >0 = max jumps per session
        jumpCooldown = 0.3,    -- seconds between allowed jumps
        _jumpCount = 0,        -- how many jumps used this session
        _lastJump = 0,         -- tick() of last jump
        -- esp
        esp = false, espName = true, espDistance = true, espBox = true, espMax = 2000,
        espColor = Color3.fromRGB(169, 105, 245),
        -- health esp
        espHealth = true,
        -- webhook / mod
        webhook = false, hookUrl = "", hookInterval = 60,
        mod = false, group = "", modAction = "Notify",
        goalMoney = 100000, goalDelivery = 50, goalTrash = 30, goalRescue = 20,
    }
    local safePos = Vector3.new(-5948, 1451, 51)
    local generation, busy, currentTween, collisions = 0, false, nil, {}
    local silentRelease, silentCollisions
    local started, startMoney, deliveries, trashed, rescues = os.clock(), 0, 0, 0, 0
    local status, stats, boardStatus
    local boardBusy, boardQueued = false, false

    local function message(value) if alive and status then status:SetText(value) end end
    local function character()
        local c = player and player.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if h and r and h.Health > 0 then return c, h, r end
    end
    local function active(token) return alive and generation == token end
    local function pause(seconds, token)
        local untilTime = os.clock() + seconds
        while active(token) and os.clock() < untilTime do task.wait(math.min(0.1, untilTime - os.clock())) end
        return active(token)
    end
    local function cancel()
        generation = generation + 1
        if silentRelease then silentRelease(false) end
        if currentTween then pcall(function() currentTween:Cancel() end); currentTween = nil end
        local _, h, r = character()
        if h and r then pcall(function() h:MoveTo(r.Position) end) end
    end
    local function partOf(object)
        if not object then return nil end
        if object:IsA("BasePart") then return object end
        return object:FindFirstChildWhichIsA("BasePart", true)
    end
    local function teleport(pos)
        local _, _, root = character(); if not root then return false end
        root.CFrame = CFrame.new(pos + Vector3.new(0, 4, 0))
        root.AssemblyLinearVelocity = Vector3.zero; root.AssemblyAngularVelocity = Vector3.zero
        return true
    end
    local function tweenSegment(pos, token)
        local _, _, root = character(); if not root or not active(token) then return false end
        local duration = math.max(0.05, (root.Position - pos).Magnitude / math.max(state.speed, 1))
        local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = CFrame.new(pos)})
        currentTween = tween
        local finished, completed = false, false
        local conn = tween.Completed:Connect(function(result) completed = result == Enum.PlaybackState.Completed; finished = true end)
        tween:Play()
        while active(token) and root.Parent and not finished do task.wait(0.05) end
        if not finished then tween:Cancel() end
        conn:Disconnect()
        if currentTween == tween then currentTween = nil end
        return active(token) and completed and root.Parent ~= nil
    end
    local function move(pos, token, method)
        method = method or state.method
        local c, hum, root = character(); if not root or not active(token) then return false end
        if method == "Silent" then return true end
        if method == "TP" then return teleport(pos) end
        local goal = pos + Vector3.new(0, 3, 0)
        if method == "Walk" then
            hum:MoveTo(goal)
            local deadline = os.clock() + math.clamp((root.Position - goal).Magnitude / math.max(hum.WalkSpeed, 1) * 2 + 8, 8, 120)
            while active(token) and root.Parent and os.clock() < deadline and (root.Position - goal).Magnitude > 6 do hum:MoveTo(goal); task.wait(0.25) end
            local arrived = active(token) and root.Parent and (root.Position - goal).Magnitude <= 6
            if not arrived then hum:MoveTo(root.Position) end
            return not not arrived
        end
        if method == "Underground" then
            local changed = {}
            for _, item in ipairs(c:GetDescendants()) do
                if item:IsA("BasePart") then
                    local original = item.CanCollide
                    if collisions[item] ~= nil then original = collisions[item] end
                    changed[item] = original; item.CanCollide = false
                end
            end
            local ok, result = pcall(function()
                return tweenSegment(root.Position - Vector3.new(0, state.depth, 0), token)
                    and tweenSegment(goal - Vector3.new(0, state.depth, 0), token)
                    and tweenSegment(goal, token)
            end)
            for item, original in pairs(changed) do pcall(function() if state.noclip then item.CanCollide = false else item.CanCollide = original end end) end
            return ok and result
        end
        return tweenSegment(goal, token)
    end
    local function touch(part, token)
        local _, _, root = character(); if not root or not part or not part.Parent or not active(token) then return false end
        if type(firetouchinterest) == "function" then
            local ok = pcall(firetouchinterest, root, part, 0); task.wait(0.05)
            pcall(firetouchinterest, root, part, 1); return ok and active(token)
        end
        if state.method == "Silent" then message("Silent touch unavailable in executor"); return false end
        root.CFrame = part.CFrame; return pause(0.1, token)
    end
    local function click(detector, token)
        if not active(token) or not detector or not detector.Parent then return false end
        local target = partOf(detector.Parent); if not target then return false end
        if not move(target.Position, token, state.method == "Silent" and "TP" or nil) then return false end
        if not active(token) or not detector.Parent then return false end
        if type(fireclickdetector) ~= "function" then message("Click executor function unavailable"); return false end
        return pcall(fireclickdetector, detector)
    end
    local function clickAll(object, token)
        local fired = false
        if object:IsA("ClickDetector") then return click(object, token) end
        for _, d in ipairs(object:GetDescendants()) do
            if not active(token) then break end
            if d:IsA("ClickDetector") and click(d, token) then fired = true end
        end
        return fired
    end
    local function mission()
        local bin = workspace:FindFirstChild("vmBin")
        return bin and player and bin:FindFirstChild(player.Name .. "'s village mission")
    end
    local function waitGone(object, seconds, token)
        if not object then return true end
        local untilTime = os.clock() + (seconds or 2)
        while active(token) and os.clock() < untilTime do
            local ok, parent = pcall(function() return object.Parent end)
            if not ok or parent == nil then return true end
            task.wait(0.15)
        end
        local ok, parent = pcall(function() return object.Parent end)
        return active(token) and (not ok or parent == nil)
    end
    local function safe(token) if state.safe and active(token) then teleport(safePos) end end
    local function interactInPlace(object, token)
        if not object or not object.Parent or not active(token) then return false end
        local fired = false
        local part = partOf(object)
        local _, _, root = character()
        if part and root and type(firetouchinterest) == "function" then
            local began = pcall(firetouchinterest, root, part, 0); task.wait(0.05)
            local ended = pcall(firetouchinterest, root, part, 1); fired = began and ended
        end
        if not active(token) then return false end
        local detectors = object:IsA("ClickDetector") and {object} or object:GetDescendants()
        for _, detector in ipairs(detectors) do
            if not active(token) then break end
            if detector:IsA("ClickDetector") and detector.Parent and type(fireclickdetector) == "function" then
                if pcall(fireclickdetector, detector) then fired = true end
            end
        end
        return fired
    end
    local function delivery(token)
        local m = mission(); if not m then message("Waiting for your mission"); return end
        for _, name in ipairs({"Letter", "DeliverPart"}) do
            if not active(token) then return end
            local obj = m:FindFirstChild(name)
            if not obj then continue end
            local part = partOf(obj)
            local fired = false
            if state.method == "Silent" then
                fired = interactInPlace(obj, token)
            elseif part then
                if move(part.Position, token) and pause(0.15, token) then
                    fired = touch(part, token) or interactInPlace(obj, token)
                    clickAll(obj, token)
                end
            else
                fired = interactInPlace(obj, token)
            end
            if not active(token) then return end
            if not fired then message("Delivery interaction unavailable: " .. name) end
            if not pause(state.fireDelay, token) then return end
            if name == "DeliverPart" then
                if waitGone(m, 6, token) then
                    deliveries = deliveries + 1
                    message("Delivery complete (" .. deliveries .. ")")
                end
            end
        end
        safe(token)
    end
    local function silentTrash(obj, part, named, token)
        local char, _, root = character(); if not root or not active(token) then return false end
        local original, oldAnchored = root.CFrame, root.Anchored
        local changed, addedConnection = {}, nil
        silentCollisions = changed
        local released = false
        local function disableCollision(item)
            if item:IsA("BasePart") and changed[item] == nil then
                local originalCollision = item.CanCollide
                if collisions[item] ~= nil then originalCollision = collisions[item] end
                changed[item] = originalCollision; item.CanCollide = false
            end
        end
        local function release(toSafe)
            if released then return end; released = true
            if addedConnection then addedConnection:Disconnect() end
            pcall(function()
                if root.Parent then
                    if player.Character == char then root.CFrame = toSafe and CFrame.new(safePos + Vector3.new(0, 4, 0)) or original end
                    root.Anchored = oldAnchored
                end
            end)
            for item, value in pairs(changed) do pcall(function()
                if state.noclip then if collisions[item] == nil then collisions[item] = value end; item.CanCollide = false else item.CanCollide = value end
            end) end
            if silentRelease == release then silentRelease, silentCollisions = nil, nil end
        end
        silentRelease = release
        local attempted, missing = false, false
        local ok, err = pcall(function()
            for _, item in ipairs(char:GetDescendants()) do disableCollision(item) end
            addedConnection = char.DescendantAdded:Connect(disableCollision)
            root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
            root.Anchored = true
            local function holdBelow(target) root.CFrame = CFrame.new(target.Position - Vector3.new(0, state.trashDepth, 0)) end
            if named and part and part.Parent and active(token) then
                if type(firetouchinterest) == "function" then
                    holdBelow(part)
                    local began = pcall(firetouchinterest, root, part, 0)
                    local ended = pcall(firetouchinterest, root, part, 1)
                    attempted = began and ended; if not attempted then missing = true end
                else missing = true end
            end
            local detectors = obj:IsA("ClickDetector") and {obj} or obj:GetDescendants()
            for _, detector in ipairs(detectors) do
                if not active(token) then break end
                if detector:IsA("ClickDetector") and detector.Parent then
                    local target = partOf(detector.Parent)
                    if target and type(fireclickdetector) == "function" then
                        holdBelow(target)
                        if pcall(fireclickdetector, detector) then attempted = true else missing = true end
                    else missing = true end
                end
            end
            if active(token) then pause(0.1, token) end
        end)
        release(ok and active(token))
        if not ok then message("Silent trash failed: " .. tostring(err))
        elseif missing then message("Some silent trash functions unavailable") end
        return ok and attempted and active(token)
    end
    local function trash(token)
        local m = mission(); if not m then message("Waiting for your mission"); return end
        local silent = state.method == "Silent"
        for _, obj in ipairs(m:GetChildren()) do
            if not active(token) then return end
            local named = obj.Name:lower():find("trash", 1, true)
            local clickable = obj:IsA("ClickDetector") or obj:FindFirstChildWhichIsA("ClickDetector", true)
            if obj.Name ~= "Letter" and obj.Name ~= "DeliverPart" and (named or clickable) then
                local part = partOf(obj)
                if silent then
                    if silentTrash(obj, part, named, token) and not obj.Parent then trashed = trashed + 1 end
                elseif part and move(part.Position, token) and pause(0.2, token) then
                    if named then touch(part, token) end
                    clickAll(obj, token)
                    if waitGone(obj, state.trashWait + 2, token) then trashed = trashed + 1 end
                end
            end
        end
        if not silent then safe(token) end
    end
    local function boardMessage(value) if alive and boardStatus then boardStatus:SetText(value) end; message(value) end
    local function board(token)
        local boards = workspace:FindFirstChild("MissionBoards")
        local b = boards and boards:FindFirstChild(state.village .. "Board")
        local cp = b and (b:FindFirstChild("Clickpart") or b:FindFirstChild("ClickPart"))
        local target = cp and (cp:FindFirstChild("Meh") or cp)
        if not target then boardMessage(state.village .. " board not found"); return end
        local fired = false
        if target:IsA("ProximityPrompt") then
            if active(token) and type(fireproximityprompt) == "function" then fired = pcall(fireproximityprompt, target) end
        elseif target:IsA("RemoteEvent") then
            if active(token) then fired = pcall(function() target:FireServer() end) end
        else
            fired = interactInPlace(target, token)
        end
        if active(token) then boardMessage(fired and ("Board interaction sent: " .. state.village) or "Board interaction unavailable") end
    end
    local function requestBoard()
        if not alive then return end
        if boardBusy then boardQueued = true; return end
        boardBusy = true
        local token = generation
        task.spawn(function()
            local deadline = os.clock() + 12
            repeat
                boardQueued = false
                local ok, err = pcall(board, token)
                if active(token) and not ok then boardMessage("Board error: " .. tostring(err)) end
            until not boardQueued or not active(token) or os.clock() > deadline
            boardBusy, boardQueued = false, false
        end)
    end

    -- ── RESCUE (fixed) ────────────────────────────────────────
    -- The original only looked for "<village>Rescue" at the top level.
    -- Now it also searches recursively so it isn't position-sensitive.
    local function findRescueModel()
        local boxes = workspace:FindFirstChild("MissionBoxes")
        if boxes then
            -- exact name first
            local m = boxes:FindFirstChild(state.village .. "Rescue")
            if m then return m end
            -- lowercase fuzzy search
            local vl = state.village:lower()
            for _, child in ipairs(boxes:GetChildren()) do
                if child.Name:lower():find(vl, 1, true) and child.Name:lower():find("rescue", 1, true) then
                    return child
                end
            end
        end
        -- also check workspace root (some game versions parent it differently)
        local vl = state.village:lower()
        for _, child in ipairs(workspace:GetChildren()) do
            if child.Name:lower():find(vl, 1, true) and child.Name:lower():find("rescue", 1, true) then
                return child
            end
        end
        return nil
    end

    local function findSensorPart(model, keyword)
        -- direct child by exact name
        local exact = model:FindFirstChild(keyword .. "SensorPart")
        if exact then return partOf(exact) end
        -- fuzzy match
        for _, child in ipairs(model:GetChildren()) do
            if child.Name:lower():find(keyword:lower(), 1, true) then
                local bp = partOf(child); if bp then return bp end
            end
        end
        -- deep search
        for _, desc in ipairs(model:GetDescendants()) do
            if desc.Name:lower():find(keyword:lower(), 1, true) and desc:IsA("BasePart") then
                return desc
            end
        end
        return nil
    end

    local function rescue(token)
        local model = findRescueModel()
        if not model then message(state.village .. " rescue not found — check village setting"); return end

        local door     = findSensorPart(model, "Door")
        local arena    = findSensorPart(model, "Arena")
        local prisoner = findSensorPart(model, "Prisoner")

        message("Rescue: waiting 2s before door...")
        if not pause(2, token) then return end

        -- Step 1: TP to door, fire, back to safe
        if door then
            teleport(door.Position)
            if not pause(0.2, token) then return end
            touch(door, token)
            if not pause(state.fireDelay, token) then return end
        else
            message("Rescue: door sensor not found, skipping")
        end

        if not active(token) then return end
        teleport(safePos)
        if not pause(0.35, token) then return end

        -- Step 2: fire arena + prisoner from safe
        if arena then
            for i = 1, state.rescueFires do
                if not active(token) then return end
                touch(arena, token)
                if not pause(state.fireDelay, token) then return end
            end
        else
            message("Rescue: arena sensor not found")
        end

        if prisoner then
            for i = 1, state.rescueFires do
                if not active(token) then return end
                touch(prisoner, token)
                if not pause(state.fireDelay, token) then return end
            end
        else
            message("Rescue: prisoner sensor not found")
        end

        -- count as done when model is gone or after a short wait
        if waitGone(model, 2, token) or active(token) then
            rescues = rescues + 1
            message("Rescue complete (" .. rescues .. ")")
        end
    end

    local function rescueM1(token)
        local model = findRescueModel()
        local char, _, root = character()
        if not model or not root then message("Rescue M1: model or character unavailable"); return end
        if type(mouse1click) ~= "function" and (type(mouse1press) ~= "function" or type(mouse1release) ~= "function") then
            message("M1 executor input unavailable"); return
        end
        local original, changed = root.CFrame, {}
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                local saved = part.CanCollide
                if collisions[part] ~= nil then saved = collisions[part] end
                changed[part] = saved; part.CanCollide = false
            end
        end
        local success, err = pcall(function()
            local untilTime = os.clock() + 5
            while active(token) and state.rescueM1 and os.clock() < untilTime and root.Parent do
                local target, closest = nil, math.huge
                for _, object in ipairs(model:GetDescendants()) do
                    if object:IsA("Humanoid") and object.Health > 0 and object.Parent then
                        local part = object.Parent:FindFirstChild("HumanoidRootPart") or partOf(object.Parent)
                        if part then
                            local distance = (part.Position - root.Position).Magnitude
                            if distance < closest then target, closest = part, distance end
                        end
                    end
                end
                if not target then message("No living rescue target"); break end
                local position = target.Position - Vector3.new(0, state.m1Depth, 0)
                root.CFrame = CFrame.lookAt(position, target.Position)
                root.AssemblyLinearVelocity = Vector3.zero
                if type(mouse1click) == "function" then mouse1click() else
                    local pressed, inputError = pcall(mouse1press)
                    pcall(mouse1release)
                    if not pressed then error(inputError) end
                end
                if not pause(state.m1Interval, token) then break end
            end
        end)
        if player.Character == char and root.Parent then pcall(function() root.CFrame = original end) end
        for part, value in pairs(changed) do pcall(function() if state.noclip then part.CanCollide = false else part.CanCollide = value end end) end
        if not success then message("Rescue M1 failed: " .. tostring(err)) end
    end

    local function money()
        local ok, value = pcall(function() return player.PlayerGui.HUD.Display.Ryo.Text end)
        if not ok then return 0 end
        return math.floor(tonumber(tostring(value):gsub("[^%d%.]", "")) or 0)
    end
    local function updateStats()
        if stats then stats:SetText(string.format("Ryo +%d | Delivery %d | Trash %d | Rescue %d", money()-startMoney, deliveries, trashed, rescues)) end
    end
    local function sendHook(reason)
        local url = tostring(state.hookUrl or ""):match("^%s*(.-)%s*$") or ""
        if not state.webhook or url == "" then
            message("Webhook off or URL empty")
            return
        end
        local req = (syn and syn.request) or (http and http.request) or request or http_request
        if type(req) ~= "function" then message("Webhook HTTP unavailable"); return end
        local elapsed = math.max(os.clock() - started, 1)
        local gained = money() - startMoney
        local payload = {
            username = "Fire Village",
            embeds = {{
                title = "Fire Village",
                description = tostring(reason or "update"),
                color = 10181046,
                fields = {
                    {name = "Ryo", value = string.format("%d / %d (+%d, %.0f/hr)", money(), state.goalMoney, gained, gained * 3600 / elapsed), inline = false},
                    {name = "Delivery", value = tostring(deliveries) .. " / " .. tostring(state.goalDelivery), inline = true},
                    {name = "Trash", value = tostring(trashed) .. " / " .. tostring(state.goalTrash), inline = true},
                    {name = "Rescue", value = tostring(rescues) .. " / " .. tostring(state.goalRescue), inline = true},
                },
                footer = { text = "Fire Village · " .. os.date("%Y-%m-%d %H:%M:%S") },
            }},
        }
        local body = HttpService:JSONEncode(payload)
        local ok, res = pcall(req, {
            Url = url,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = body,
        })
        if not ok then
            message("Webhook request failed: " .. tostring(res))
            return
        end
        local code = type(res) == "table" and (res.StatusCode or res.status_code)
        if code and code >= 400 then
            message("Webhook HTTP " .. tostring(code))
        else
            message("Webhook sent")
        end
    end
    local function runOnce(fn)
        if not alive then return end
        if busy then message("Farm is busy"); return end
        busy = true
        local token = generation
        task.spawn(function()
            local ok, err = pcall(fn, token)
            busy = false
            if alive and not ok then message("Action failed: " .. tostring(err)) end
            if alive then updateStats() end
        end)
    end
    local function launchWorker()
        if not alive then return end
        cancel()
        local token = generation
        message("Farm running")
        if state.mission then
            task.spawn(function()
                while active(token) and state.running and state.mission do
                    requestBoard()
                    if not pause(state.boardPause, token) then break end
                end
            end)
        end
        task.spawn(function()
            local nextHook = 0
            local busySince = 0
            while active(token) and state.running do
                if busy and busySince > 0 and os.clock() - busySince > 45 then
                    message("Farm was stuck — forcing unlock")
                    busy = false
                    busySince = 0
                end
                if not busy then
                    busy = true
                    busySince = os.clock()
                    local ok, err = pcall(function()
                        local m = mission()
                        if not m and state.mission and active(token) then
                            requestBoard()
                            pause(0.8, token)
                        end
                        if state.delivery  and active(token) then delivery(token)  end
                        if state.trash     and active(token) then trash(token)     end
                        if state.rescue    and active(token) then rescue(token)    end
                        if state.rescueM1  and active(token) then rescueM1(token)  end
                    end)
                    busy = false
                    busySince = 0
                    if not ok then message("Farm error: " .. tostring(err)) end
                    updateStats()
                end
                if state.webhook and os.clock() >= nextHook then
                    pcall(function() sendHook("Scheduled update") end)
                    nextHook = os.clock() + math.max(state.hookInterval, 15)
                end
                if not pause(0.5, token) then break end
            end
        end)
    end
    local function start()
        if not alive or state.running then return end
        state.running = true
        started, startMoney, deliveries, trashed, rescues = os.clock(), money(), 0, 0, 0
        launchWorker()
    end
