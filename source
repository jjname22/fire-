local function parkEnvironment(object)
    if object ~= worldSky and object ~= worldAir and (object:IsA("Sky") or object:IsA("Atmosphere")) then
        savedEnvironment[object] = true; object.Parent = nil
    end
end
local function restoreWorld()
    worldSky.Parent, worldAir.Parent = nil, nil
    for object in pairs(savedEnvironment) do
        pcall(function() if object.Parent == nil then object.Parent = Lighting end end)
    end
    savedEnvironment = {}
    if savedClock ~= nil and Lighting.ClockTime == imposedClock then Lighting.ClockTime = savedClock end
    savedClock, imposedClock = nil, nil
end
local function applyWorld()
    if not settings.world then restoreWorld(); return end
    if savedClock == nil then savedClock = Lighting.ClockTime end
    for _, object in ipairs(Lighting:GetChildren()) do parkEnvironment(object) end
    local preset = worldPresets[settings.worldPreset] or worldPresets["Violet night"]
    worldSky.StarCount, worldSky.CelestialBodiesShown = settings.stars, true
    worldAir.Color, worldAir.Decay = preset.color, preset.decay
    worldAir.Density, worldAir.Haze, worldAir.Glare = settings.haze, 1.4, 0.15
    imposedClock = preset.time; Lighting.ClockTime = imposedClock
    worldSky.Parent, worldAir.Parent = Lighting, Lighting
end
connect(Lighting.ChildAdded, function(object) if settings.world then parkEnvironment(object) end end)

local morph = {ticket = 0, model = nil, root = nil, hidden = {}, connections = {}, tracks = {}}
local MorphStatus
local function morphStatus(message) if alive and MorphStatus then MorphStatus:SetText(message) end end
local function clearMorph()
    morph.ticket = morph.ticket + 1
    for _, connection in ipairs(morph.connections) do connection:Disconnect() end
    morph.connections = {}
    if morph.model then morph.model:Destroy() end
    morph.model, morph.root, morph.tracks = nil, nil, {}
    for part, value in pairs(morph.hidden) do
        pcall(function() if part.LocalTransparencyModifier == 1 then part.LocalTransparencyModifier = value end end)
    end
    morph.hidden = {}
end
local function loadMorph()
    clearMorph()
    local ticket, target = morph.ticket, settings.morphTarget:match("^%s*(.-)%s*$")
    if target == "" then morphStatus("Enter a username or user ID"); return end
    morphStatus("Loading avatar...")
    task.spawn(function()
        local model, description
        local success = pcall(function()
            local player = Players.LocalPlayer
            local character = player and player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local root = character and character:FindFirstChild("HumanoidRootPart")
            assert(humanoid and root, "Character unavailable")
            local userId = tonumber(target) or Players:GetUserIdFromNameAsync(target)
            description = Players:GetHumanoidDescriptionFromUserIdAsync(userId)
            if not alive or morph.ticket ~= ticket then return end
            model = Players:CreateHumanoidModelFromDescriptionAsync(description, humanoid.RigType)
            if not alive or morph.ticket ~= ticket or player.Character ~= character then return end
            local cloneHumanoid = model:FindFirstChildOfClass("Humanoid")
            local cloneRoot = model:FindFirstChild("HumanoidRootPart")
            assert(cloneHumanoid and cloneRoot, "Avatar unavailable")
            model.Name = "LarpsenseAvatar"
            for _, object in ipairs(model:GetDescendants()) do
                if object:IsA("BasePart") then
                    object.CanCollide, object.CanTouch, object.CanQuery, object.Massless = false, false, false, true
                    object.Anchored = object == cloneRoot
                elseif object:IsA("Script") or object:IsA("LocalScript") then object:Destroy() end
            end
            cloneHumanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
            cloneHumanoid.AutoRotate = false
            model:PivotTo(root.CFrame); model.Parent = workspace
            morph.model, morph.root = model, root; model = nil
            local function hide(object)
                if object:IsA("BasePart") then
                    morph.hidden[object] = object.LocalTransparencyModifier
                    object.LocalTransparencyModifier = 1
                end
            end
            for _, object in ipairs(character:GetDescendants()) do hide(object) end
            table.insert(morph.connections, character.DescendantAdded:Connect(hide))
            local animator = humanoid:FindFirstChildOfClass("Animator")
            local cloneAnimator = cloneHumanoid:FindFirstChildOfClass("Animator")
            if not cloneAnimator then cloneAnimator = Instance.new("Animator"); cloneAnimator.Parent = cloneHumanoid end
            local function mirror(track)
                if morph.tracks[track] or not track.Animation then return end
                pcall(function()
                    local copy = cloneAnimator:LoadAnimation(track.Animation)
                    copy.Priority, copy.Looped = track.Priority, track.Looped
                    copy:Play(0.1, track.WeightCurrent, track.Speed)
                    copy.TimePosition = track.TimePosition
                    morph.tracks[track] = copy
                end)
            end
            if animator then
                for _, track in ipairs(animator:GetPlayingAnimationTracks()) do mirror(track) end
                table.insert(morph.connections, animator.AnimationPlayed:Connect(mirror))
            end
            morphStatus("Avatar applied (local)")
        end)
        if description then description:Destroy() end
        if model then model:Destroy() end
        if not success and alive and morph.ticket == ticket then clearMorph(); morphStatus("Avatar unavailable — check username or rig support") end
    end)
end
local characterFx = {character = nil, root = nil}
local function clearCharacterFx()
    for _, name in ipairs({"highlight", "trail", "a", "b"}) do
        if characterFx[name] then characterFx[name]:Destroy(); characterFx[name] = nil end
    end
    characterFx.character, characterFx.root = nil, nil
end
local function updateCharacterFx(character, root, accent)
    if characterFx.character ~= character or characterFx.root ~= root then clearCharacterFx(); characterFx.character, characterFx.root = character, root end
    if not root then return end
    if settings.outline and not characterFx.highlight then
        local highlight = Instance.new("Highlight")
        highlight.Name, highlight.FillTransparency, highlight.OutlineTransparency = "LarpsenseOutline", 1, 0.15
        highlight.DepthMode, highlight.Parent = Enum.HighlightDepthMode.Occluded, workspace
        characterFx.highlight = highlight
    end
    if characterFx.highlight then
        characterFx.highlight.Enabled, characterFx.highlight.Adornee = settings.outline, morph.model or character
        characterFx.highlight.OutlineColor = accent
    end
    if settings.trail and not characterFx.trail then
        local a, b, trail = Instance.new("Attachment"), Instance.new("Attachment"), Instance.new("Trail")
        a.Position, b.Position = Vector3.new(-0.7, -1, 0.4), Vector3.new(0.7, -1, 0.4)
        a.Parent, b.Parent = root, root
        trail.Name, trail.Attachment0, trail.Attachment1 = "LarpsenseTrail", a, b
        trail.Lifetime, trail.FaceCamera, trail.LightEmission = 0.5, true, 0.6
        trail.Transparency = NumberSequence.new(0.25, 1); trail.Parent = root
        characterFx.a, characterFx.b, characterFx.trail = a, b, trail
    end
    if characterFx.trail then characterFx.trail.Enabled, characterFx.trail.Color = settings.trail, ColorSequence.new(accent) end
end
