    local flying, gyro, oldSpeed, speedHum, appliedSpeed = nil, nil, nil, nil, nil
    local function stopFly()
        if flying then flying:Destroy(); flying = nil end
        if gyro   then gyro:Destroy();  gyro   = nil end
    end
    local function restoreCollisions()
        for part, value in pairs(collisions) do pcall(function()
            if silentCollisions and silentCollisions[part] ~= nil then part.CanCollide = false else part.CanCollide = value end
        end) end
        collisions = {}
    end
    local function restoreSpeed()
        if speedHum and oldSpeed ~= nil then pcall(function() if speedHum.WalkSpeed == appliedSpeed then speedHum.WalkSpeed = oldSpeed end end) end
        speedHum, oldSpeed, appliedSpeed = nil, nil, nil
    end

    connect(RunService.Heartbeat, function()
        local c, hum, root = character()
        if speedHum ~= hum then restoreSpeed() end
        if hum and state.speedOn then
            if not speedHum then speedHum, oldSpeed = hum, hum.WalkSpeed end
            hum.WalkSpeed, appliedSpeed = state.walkSpeed, state.walkSpeed
        elseif speedHum then restoreSpeed() end
        if c and state.noclip then
            for _, part in ipairs(c:GetDescendants()) do if part:IsA("BasePart") then
                if collisions[part] == nil then
                    local originalCollision = part.CanCollide
                    if silentCollisions and silentCollisions[part] ~= nil then originalCollision = silentCollisions[part] end
                    collisions[part] = originalCollision
                end
                part.CanCollide = false
            end end
        elseif next(collisions) then restoreCollisions() end
        if not state.fly or not root then stopFly(); return end
        if not flying or flying.Parent ~= root then
            stopFly()
            flying = Instance.new("BodyVelocity"); flying.MaxForce = Vector3.new(9e9,9e9,9e9); flying.Parent = root
            gyro   = Instance.new("BodyGyro");    gyro.MaxTorque  = Vector3.new(9e9,9e9,9e9); gyro.P = 9e4; gyro.Parent = root
        end
        local cam = workspace.CurrentCamera; if not cam then return end
        local dir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector  end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector  end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space)       then dir = dir + Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0,1,0) end
        flying.Velocity = dir.Magnitude > 0 and dir.Unit * state.flySpeed or Vector3.zero
        gyro.CFrame = cam.CFrame
    end)

    -- ── JUMP LIMITER ─────────────────────────────────────────
    -- JumpRequest fires every time the player presses Space.
    -- We allow it only when:
    --   • state.jump is true
    --   • cooldown has passed
    --   • if jumpLimit > 0, we haven't used all jumps yet
    connect(UserInputService.JumpRequest, function()
        if not state.jump or UserInputService:GetFocusedTextBox() then return end
        local now = tick()
        -- cooldown gate
        if now - state._lastJump < state.jumpCooldown then return end
        -- limit gate
        if state.jumpLimit > 0 and state._jumpCount >= state.jumpLimit then
            message(string.format("Jump limit reached (%d/%d) — reset to recharge", state._jumpCount, state.jumpLimit))
            return
        end
        local _, hum = character(); if not hum then return end
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
        state._lastJump  = now
        state._jumpCount = state._jumpCount + 1
        if state.jumpLimit > 0 then
            message(string.format("Jump %d / %d", state._jumpCount, state.jumpLimit))
        end
    end)

