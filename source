local function clock(ms)
    local seconds = math.floor(math.max(0, tonumber(ms) or 0) / 1000)
    return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end
local function lyricAt(lines, seconds)
    local low, high, found = 1, #lines, 0
    while low <= high do
        local mid = math.floor((low + high) / 2)
        if (tonumber(lines[mid].time) or 0) <= seconds then found, low = mid, mid + 1 else high = mid - 1 end
    end
    return found
end
local lastText = {}
local function text(control, value)
    if lastText[control] ~= value then control:SetText(value); lastText[control] = value end
end
local function updateDisplay(now)
    local song, artist, album, state, progress = "Waiting for Spotify", "—", "—", offline, "--:-- / --:--"
    local line, following, actualLine, fraction, lyricKey = offline, "", "", 0, ""
    local playing = data and data.token_ok and data.source == "smtc" and data.playing
    if data and not data.token_ok then
        song, state, line = "Nothing playing", "Idle", "Waiting for a track"
    elseif data and data.token_ok then
        song, artist, album = data.song or "Unknown track", data.artist or "Unknown artist", data.album or ""
        if album == "" then album = "—" end
        state = data.source == "window" and "Detected (no timeline)" or (data.playing and "Playing" or "Paused")
        local length = tonumber(data.duration_ms) or 0
        if data.source == "smtc" and length > 0 then
            local position = tonumber(data.progress_ms) or 0
            if playing then position = position + math.max(0, now - receivedAt) * 1000 end
            position = math.clamp(position, 0, length)
            progress, fraction = clock(position) .. " / " .. clock(length), position / length
            if type(data.lyrics) == "table" and #data.lyrics > 0 then
                local index = lyricAt(data.lyrics, position / 1000 + settings.offset)
                lyricKey    = song .. "\0" .. artist .. "\0" .. tostring(index)
                actualLine  = index > 0 and (data.lyrics[index].text or "") or ""
                line        = actualLine ~= "" and actualLine or "Instrumental"
                following   = data.lyrics[index + 1] and data.lyrics[index + 1].text or ""
            else
                line = data.lyrics_status == "plain" and "Plain lyrics in menu (no timestamps)" or "Synced lyrics unavailable"
            end
        else
            line = "Timeline unavailable"
        end
    end
    text(Song,   "Track: "    .. song)
    text(Artist, "Artist: "   .. artist)
    text(Album,  "Album: "    .. album)
    text(Status, "Status: "   .. state .. (settings.waves and not spectrumAvailable and " • audio unavailable" or ""))
    text(Progress, "Progress: " .. progress)
    text(Current, data and data.lyrics_status == "plain" and data.lyrics_plain or line)
    text(Next,    following ~= "" and ("Next: " .. following) or "")
    titleLbl.Text, artistLabel.Text, timeLabel.Text = song, artist, progress
    playButton.Text = playing and "PAUSE" or "PLAY"
    local caps = data and data.controls or {}
    playButton.TextColor3 = caps.play_pause and textColor or dim
    nextButton.TextColor3 = caps.next       and textColor or dim
    progressFill.Size     = UDim2.fromScale(fraction, 1)
    hudStatus.Text = now < controlMessageUntil and controlMessage or
        (settings.lyrics and actualLine ~= "" and actualLine or
        (not data and offline or (spectrumAvailable and state or state .. " • audio unavailable")))
    local newLine = settings.sky and settings.lyrics and actualLine or ""
    if newLine ~= "" and skyAnchorKey ~= lyricKey then skyAnchorKey, skyOrigin = lyricKey, nil end
    if skyLine ~= newLine then
        previousSkyLine, skyLine, skyTransition = skyLine, newLine, now
        skyOld.Text, skyNew.Text = previousSkyLine, skyLine
    end
end

local lastTextUpdate = 0
connect(RunService.RenderStepped, function(dt)
    local now = os.clock()
    if now - lastTextUpdate >= 0.1 then lastTextUpdate = now; updateDisplay(now) end
    local accent = Library.Theme["Accent"]
    accentLine.BackgroundColor3, progressFill.BackgroundColor3 = accent, accent
    local waveActive = data and data.token_ok and (data.source == "window" or (data.source == "smtc" and data.playing)) and spectrumAvailable and settings.waves
    for i, bar in ipairs(bars) do
        local target = waveActive and math.clamp(((tonumber(spectrum[i]) or 0) * settings.gain) ^ 0.8, 0, 1) or 0
        local rate = target > displayedBands[i] and 26 or 7
        displayedBands[i] = displayedBands[i] + (target - displayedBands[i]) * (1 - math.exp(-math.min(dt, 0.25) * rate))
        local height = 2 + math.floor(26 * displayedBands[i])
        bar.Size, bar.Position = UDim2.fromOffset(5, height), UDim2.fromOffset((i - 1) * 9, 28 - height)
        bar.BackgroundColor3, bar.BackgroundTransparency = accent, 0.85 - 0.7 * displayedBands[i]
    end
    local character = Players.LocalPlayer and Players.LocalPlayer.Character
    local root      = character and character:FindFirstChild("HumanoidRootPart")
    if morph.model then
        if morph.root ~= root or not root or not root.Parent then clearMorph()
        else
            morph.model:PivotTo(root.CFrame)
            for part in pairs(morph.hidden) do if part.Parent then part.LocalTransparencyModifier = 1 end end
            for original, copy in pairs(morph.tracks) do
                pcall(function()
                    if not original.IsPlaying then copy:Stop(0.1); copy:Destroy(); morph.tracks[original] = nil
                    else
                        copy:AdjustSpeed(original.Speed)
                        if math.abs(copy.TimePosition - original.TimePosition) > 0.15 then copy.TimePosition = original.TimePosition end
                    end
                end)
            end
        end
    end
    updateCharacterFx(character, root, accent)
    if skyPart and root and settings.sky and settings.lyrics and (skyLine ~= "" or previousSkyLine ~= "") then
        if not skyOrigin or skyRoot ~= root then
            skyRoot, skyOrigin = root, root.Position
            local look = root.CFrame.LookVector
            local flat = Vector3.new(look.X, 0, look.Z)
            skyDirection = flat.Magnitude > 0.01 and flat.Unit or Vector3.new(0, 0, -1)
        end
        skyPart.Position = skyOrigin + skyDirection * settings.skyDistance + Vector3.new(0, settings.skyHeight, 0)
        skyGui.Enabled = true
        local alpha = math.clamp((now - skyTransition) / settings.fade, 0, 1)
        skyNew.TextTransparency      = skyLine          ~= "" and (1 - alpha)        or 1
        skyOld.TextTransparency      = previousSkyLine  ~= "" and alpha               or 1
        skyNew.TextStrokeTransparency= skyLine          ~= "" and (1 - alpha * 0.7)  or 1
        skyOld.TextStrokeTransparency= previousSkyLine  ~= "" and (0.3 + alpha * 0.7) or 1
        skyNew.TextColor3, skyOld.TextColor3 = settings.skyColor, settings.skyColor
        skyNew.TextSize,   skyOld.TextSize   = settings.skySize,   settings.skySize
        if alpha >= 1 then previousSkyLine = "" end
    else
        skyGui.Enabled = false
    end
end)

